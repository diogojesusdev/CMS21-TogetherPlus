      <!--
    Game assemblies (generated from Car Mechanic Simulator 2021 by MelonLoader 0.5.7, never committed): taken from
    $(GamePath)\MelonLoader\Managed. build.ps1 finds the game through Steam, or pass -GamePath / -p:GamePath=...
    Without GamePath a local Libs\ copy is used if present, else the default Steam folder.
  -->
  <PropertyGroup>
    <GamePath Condition="'$(GamePath)' == ''">$(CMS21_GAME_PATH)</GamePath>
    <GameLibs Condition="'$(GamePath)' != ''">$(GamePath)\MelonLoader\Managed</GameLibs>
    <MelonLoaderDll Condition="'$(GamePath)' != ''">$(GamePath)\MelonLoader\MelonLoader.dll</MelonLoaderDll>
    <GameLibs Condition="'$(GameLibs)' == '' And Exists('$(MSBuildThisFileDirectory)Libs\Assembly-CSharp.dll')">$(MSBuildThisFileDirectory)Libs</GameLibs>
    <MelonLoaderDll Condition="'$(MelonLoaderDll)' == '' And Exists('$(MSBuildThisFileDirectory)Libs\MelonLoader.dll')">$(MSBuildThisFileDirectory)Libs\MelonLoader.dll</MelonLoaderDll>
    <GamePath Condition="'$(GameLibs)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Car Mechanic Simulator 2021</GamePath>
    <GameLibs Condition="'$(GameLibs)' == ''">$(GamePath)\MelonLoader\Managed</GameLibs>
    <MelonLoaderDll Condition="'$(MelonLoaderDll)' == ''">$(GamePath)\MelonLoader\MelonLoader.dll</MelonLoaderDll>
  </PropertyGroup>
  <Target Name="CheckGameAssemblies" BeforeTargets="ResolveAssemblyReferences">
